# Copy to .env.local for local development, and add the same names in Vercel →
# Project → Settings → Environment Variables. Never commit real values.

# Claude explanations on /analyze (Token Check). Optional: without it, the Guard
# Score and checks still work and the page says AI is switched off.
ANTHROPIC_API_KEY=

# Solana RPC endpoint. Optional: defaults to the free public mainnet RPC, which
# rate-limits some calls (holder concentration). A free Helius key fixes that:
# https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=
